@@ -0,0 +1,239 @@
+"""CS 260C perception-guided racing pilot for the Elodin harness.
+
+This solver deliberately ignores Elodin's world pose. It consumes only the FPV
+frame plus IMU-like telemetry and delegates the racing logic to the course repo
+at `/Users/matthewhutchinson/dev/cs260c-project/algorithm`.
+"""
+
+from __future__ import annotations
+
+import atexit
+import csv
+import os
+import sys
+from pathlib import Path
+
+import numpy as np
+
+from solver.api import RCCommand, SensorUpdate
+
+
+PROJECT_ROOT = Path("/Users/matthewhutchinson/dev/cs260c-project")
+if str(PROJECT_ROOT) not in sys.path:
+    sys.path.insert(0, str(PROJECT_ROOT))
+
+from algorithm import AutonomousRacingPilot, VehicleTelemetry  # noqa: E402
+from algorithm.control_adapter import to_betaflight_rc_fields  # noqa: E402
+
+
+T_DISARMED_END = 0.50
+T_ARM_IDLE_END = 0.75
+T_TAKEOFF_END = 1.60
+
+TAKEOFF_THROTTLE = 1300
+
+_pilot = AutonomousRacingPilot(frame_format="rgb")
+_last_tick = -1
+_trace_file = None
+_trace_writer = None
+_frame_save_count = 0
+_frame_dir_announced = False
+
+
+def _env_int(name: str, default: int) -> int:
+    raw = os.environ.get(name)
+    if raw is None:
+        return default
+    try:
+        return int(raw)
+    except ValueError:
+        return default
+
+
+def _open_trace() -> csv.DictWriter | None:
+    global _trace_file, _trace_writer
+
+    if _trace_writer is not None:
+        return _trace_writer
+
+    trace_path = os.environ.get("CS260C_PILOT_TRACE")
+    if not trace_path:
+        return None
+
+    path = Path(trace_path).expanduser()
+    path.parent.mkdir(parents=True, exist_ok=True)
+    _trace_file = path.open("w", newline="")
+    _trace_writer = csv.DictWriter(
+        _trace_file,
+        fieldnames=[
+            "tick",
+            "timestamp_s",
+            "frame_fresh",
+            "mode",
+            "confidence",
+            "bearing_h_rad",
+            "bearing_v_rad",
+            "distance_m",
+            "pixel_x",
+            "pixel_y",
+            "roll_rate_rad_s",
+            "pitch_rate_rad_s",
+            "yaw_rate_rad_s",
+            "thrust_norm",
+            "rc_throttle",
+            "rc_roll",
+            "rc_pitch",
+            "rc_yaw",
+            "rc_arm",
+        ],
+    )
+    _trace_writer.writeheader()
+    print(f"[CS260C] writing pilot trace to {path}")
+    return _trace_writer
+
+
+def _close_trace() -> None:
+    global _trace_file, _trace_writer
+
+    if _trace_file is not None:
+        _trace_file.close()
+    _trace_file = None
+    _trace_writer = None
+
+
+atexit.register(_close_trace)
+
+
+def reset_state() -> None:
+    global _last_tick, _frame_save_count
+    _pilot.reset()
+    _last_tick = -1
+    _frame_save_count = 0
+
+
+def _trace(update: SensorUpdate, gate, command, rc: dict[str, int]) -> None:
+    writer = _open_trace()
+    if writer is None:
+        return
+
+    if not update.frame_fresh and update.tick % 20 != 0:
+        return
+
+    writer.writerow(
+        {
+            "tick": int(update.tick),
+            "timestamp_s": f"{float(update.t):.6f}",
+            "frame_fresh": int(bool(update.frame_fresh)),
+            "mode": gate.mode.value,
+            "confidence": f"{gate.confidence:.6f}",
+            "bearing_h_rad": f"{gate.bearing_h_rad:.6f}",
+            "bearing_v_rad": f"{gate.bearing_v_rad:.6f}",
+            "distance_m": "" if gate.distance_m is None else f"{gate.distance_m:.6f}",
+            "pixel_x": "" if gate.pixel_center is None else f"{gate.pixel_center[0]:.3f}",
+            "pixel_y": "" if gate.pixel_center is None else f"{gate.pixel_center[1]:.3f}",
+            "roll_rate_rad_s": f"{command.roll_rate_rad_s:.6f}",
+            "pitch_rate_rad_s": f"{command.pitch_rate_rad_s:.6f}",
+            "yaw_rate_rad_s": f"{command.yaw_rate_rad_s:.6f}",
+            "thrust_norm": f"{command.thrust_norm:.6f}",
+            "rc_throttle": rc["throttle"],
+            "rc_roll": rc["roll"],
+            "rc_pitch": rc["pitch"],
+            "rc_yaw": rc["yaw"],
+            "rc_arm": rc["arm"],
+        }
+    )
+
+
+def _frame_rgb(update: SensorUpdate) -> np.ndarray | None:
+    if update.frame_rgba is None:
+        return None
+    frame = np.asarray(update.frame_rgba)
+    if frame.ndim != 3 or frame.shape[2] < 3:
+        return None
+    return frame[:, :, :3]
+
+
+def _save_frame(update: SensorUpdate, frame_rgb: np.ndarray | None) -> None:
+    """Optionally save fresh FPV frames for offline detector validation."""
+    global _frame_save_count, _frame_dir_announced
+
+    frame_dir = os.environ.get("CS260C_FRAME_DIR")
+    if not frame_dir or frame_rgb is None or not update.frame_fresh:
+        return
+
+    stride = max(1, _env_int("CS260C_FRAME_STRIDE", 1))
+    if _frame_save_count % stride != 0:
+        _frame_save_count += 1
+        return
+
+    path = Path(frame_dir).expanduser()
+    path.mkdir(parents=True, exist_ok=True)
+    if not _frame_dir_announced:
+        print(f"[CS260C] saving FPV frames to {path}")
+        _frame_dir_announced = True
+
+    image = np.asarray(frame_rgb, dtype=np.uint8)
+    if image.ndim != 3 or image.shape[2] < 3:
+        return
+    image = np.ascontiguousarray(image[:, :, :3])
+    height, width = image.shape[:2]
+    out_path = path / f"fpv_{int(update.tick):07d}_{float(update.t):08.3f}.ppm"
+    with out_path.open("wb") as f:
+        f.write(f"P6\n{width} {height}\n255\n".encode("ascii"))
+        f.write(image.tobytes())
+    _frame_save_count += 1
+
+
+def _telemetry(update: SensorUpdate) -> VehicleTelemetry:
+    return VehicleTelemetry(
+        angular_rates_rad_s=np.asarray(update.gyro, dtype=np.float64),
+        acceleration_m_s2=np.asarray(update.accel, dtype=np.float64),
+        timestamp_s=float(update.t),
+    )
+
+
+def _centered(throttle: int, *, arm: bool = True) -> RCCommand:
+    return RCCommand(
+        arm=1800 if arm else 1000,
+        throttle=int(throttle),
+        roll=1500,
+        pitch=1500,
+        yaw=1500,
+    )
+
+
+def autopilot(update: SensorUpdate) -> RCCommand:
+    """Elodin solver entrypoint."""
+    global _last_tick
+
+    if update.tick < _last_tick:
+        reset_state()
+    _last_tick = update.tick
+
+    if update.t < T_DISARMED_END:
+        return _centered(1000, arm=False)
+
+    if update.t < T_ARM_IDLE_END:
+        return _centered(1000, arm=True)
+
+    if update.t < T_TAKEOFF_END:
+        return _centered(TAKEOFF_THROTTLE, arm=True)
+
+    frame_rgb = _frame_rgb(update)
+    _save_frame(update, frame_rgb)
+
+    command, gate = _pilot.update(
+        frame_rgb,
+        _telemetry(update),
+        timestamp_s=float(update.t),
+    )
+    rc = to_betaflight_rc_fields(command)
+    _trace(update, gate, command, rc)
+
+    return RCCommand(
+        arm=rc["arm"],
+        throttle=rc["throttle"],
+        roll=rc["roll"],
+        pitch=rc["pitch"],
+        yaw=rc["yaw"],
+    )
